# ============================================================================
# No-Peek Environment Configuration (.env)
# ============================================================================

# Mode Eksekusi Aplikasi:
# - dev  : Menampilkan jendela preview kamera OpenCV untuk debugging + Dynamic Island GUI
# - prod : Menyembunyikan jendela kamera OpenCV (headless), berjalan di System Tray (Windows) / Menu Bar (macOS) + Dynamic Island GUI
NOPEEK_ENV=dev

# Konfigurasi IPC (Inter-Process Communication):
# - stdio : Rust men-spawn Python sebagai child process dan berkomunikasi via stdin/stdout JSON Lines (Recommended)
# - tcp   : Komunikasi JSON Lines via soket TCP lokal (berguna saat men-debug Python dan Rust secara terpisah)
NOPEEK_IPC_MODE=stdio
NOPEEK_IPC_HOST=127.0.0.1
NOPEEK_IPC_PORT=17890
NOPEEK_IPC_HEARTBEAT_S=2.0

# Konfigurasi Kamera & Model (Python Inference):
NOPEEK_CAMERA_INDEX=0
NOPEEK_CAMERA_WIDTH=1280
NOPEEK_CAMERA_HEIGHT=720
NOPEEK_MIRROR=true
NOPEEK_YOLO_MODEL=model/yolov8n-face.onnx
NOPEEK_POSE_MODEL=model/face_landmarker.task
NOPEEK_ONNX_THREADS=2

# Parameter Deteksi & Aturan Spasial/Temporal:
NOPEEK_CONFIDENCE=0.50
NOPEEK_IOU=0.45
NOPEEK_MAX_YAW=35.0
NOPEEK_MAX_PITCH=25.0
NOPEEK_MAX_ROLL=35.0
NOPEEK_FOV_DEG=60.0
NOPEEK_FRIEND_MARGIN_CM=25.0
NOPEEK_AUTO_CALIBRATE=true

# Konfigurasi UI Dynamic Island (Rust GUI - dalam satuan DIP):
NOPEEK_IDLE_WIDTH=140.0
NOPEEK_IDLE_HEIGHT=8.0
NOPEEK_ALERT_HEIGHT=44.0
NOPEEK_ALERT_MIN_WIDTH=240.0
NOPEEK_ALERT_MAX_WIDTH=460.0
NOPEEK_ALERT_MARGIN_X=18.0
NOPEEK_ALERT_MARGIN_Y=10.0

# Teks Peringatan Kustom (Tanpa Emoji Unicode):
NOPEEK_TEXT_ALERT=Pengintip Terdeteksi
NOPEEK_TEXT_ESCALATED=Bahaya! Layar Sedang Diintip
